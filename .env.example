# Copy to .env (or set in your secret manager / Fly secrets) and fill in.
# .env is gitignored. NEVER commit real values.
#
# Public Spotify client id (PKCE, no secret). Register in the Spotify
# Developer Dashboard. The callback must be <APP_BASE_URL>/api/auth/spotify/callback.
SPOTIFY_CLIENT_ID=

# Optional SoundCloud OAuth credentials. The redirect must be registered with
# the SoundCloud application and must match the configured public base URL.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Public HTTPS origin of Riff. The Spotify callback is derived from this value.
APP_BASE_URL=https://riff.ryo-nd.com

# Session signing secret. Generate with:
#   python -m csv_to_clonehero keys
SECRET_KEY=

# Fernet key used to encrypt each user's Spotify refresh token at rest.
# Generate with:
#   python -m csv_to_clonehero keys
TOKEN_ENCRYPTION_KEY=

# Optional: absolute sqlite database path override (default state/csv_to_clonehero.db).
# DATABASE_URL=sqlite:////data/csv_to_clonehero.db

# Complete checksum-valid Enchor metadata snapshot on persistent server state.
# The image does not contain this generated file. Docker Compose defaults here.
CATALOG_PATH=/data/catalog/enchor.jsonl

# Transactional email for long-job completion notifications only.
# NOTIFICATIONS_API_KEY=
# The sender address is configured as notifications.from_address in config.yaml.

# Optional verified support URL. No default campaign is configured.
# Also enable monetization.gofundme_enabled and gofundme_banner in config.
# GOFUNDME_URL=

# Redis / Postgres are intentionally not required: this is a single-instance
# deployment with a SQLite volume (see docs/runbook.md).
