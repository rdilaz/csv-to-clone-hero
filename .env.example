# Copy to .env (or set in your secret manager / Fly secrets) and fill in.
# .env is gitignored. NEVER commit real values.
#
# Public Spotify client id (PKCE, no secret). Register in the Spotify
# Developer Dashboard. The callback must be <APP_BASE_URL>/api/auth/spotify/callback.
SPOTIFY_CLIENT_ID=

# Public HTTPS origin of the product (one subdomain per product, e.g. charts.ryo-nd.com).
APP_BASE_URL=https://charts.ryo-nd.com

# Session signing secret. Generate with:
#   python -m csv_to_clonehero keys
SECRET_KEY=

# Fernet key used to encrypt each user's Spotify refresh token at rest.
# Generate with:
#   python -m csv_to_clonehero keys
TOKEN_ENCRYPTION_KEY=

# Optional: absolute sqlite database path override (default state/csv_to_clonehero.db).
# DATABASE_URL=sqlite:///data/csv_to_clonehero.db

# Transactional email for long-job completion notifications only.
# NOTIFICATIONS_API_KEY=
# NOTIFICATIONS_FROM=noreply@ryo-nd.com

# Core platform mission: the Clone Hero creator's GoFundMe.
# GOFUNDME_URL=

# Redis / Postgres are intentionally not required: this is a single-instance
# deployment with a SQLite volume (see docs/runbook.md).