# User data - never commit private playlist exports
input_playlists/*.csv
input_playlists/*.txt
input_playlists/*.xml
input_playlists/*.json
input_playlists/*.jsonl
overrides.yaml

# The catalog is a large, generated metadata snapshot. Keep it local and
# regenerate it with `catalog-export` rather than pushing it to GitHub.
catalog/*.jsonl
catalog/*.partial
catalog/*.checkpoint.json

# Secrets and local configuration - NEVER commit
config.yaml
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Application state and output
state/
output_library/
reports/
logs/
backups/
*.part
*.sng.part

# Local tooling and stray files (never commit)
.kilo/
*.png
csv to clone hero/

# Operator launchers that may embed machine-specific access tokens
WEB_REMOTE.bat
REMOTE_TUNNEL.bat

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
