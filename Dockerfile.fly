# ---------------------------------------------------------------------------
# Riff on Fly.io: same image as Dockerfile, plus an entrypoint that hands the
# root-owned Fly volume at /data to the app user before dropping root.
# Docker Compose on the Aero keeps using ./Dockerfile unchanged.
# ---------------------------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

ARG RIFF_SOURCE_REVISION=unknown
ENV RIFF_SOURCE_REVISION=${RIFF_SOURCE_REVISION}
LABEL org.opencontainers.image.revision=${RIFF_SOURCE_REVISION}

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
COPY browser_export ./browser_export
COPY wsgi.py ./
RUN pip install --no-cache-dir --no-deps .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /data /app/state \
    && chown -R appuser:appuser /app /data
COPY scripts/fly-entrypoint.sh /usr/local/bin/riff-entrypoint
RUN chmod 0755 /usr/local/bin/riff-entrypoint

ENV DATABASE_URL=sqlite:////data/csv_to_clonehero.db \
    CATALOG_PATH=/data/catalog/enchor.jsonl

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/riff-entrypoint"]
CMD ["python", "-m", "waitress", "--listen=0.0.0.0:8000", "--threads=8", "wsgi:app"]
